{"nodes": [{"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_workflow", "label": "Resident Day-Off Request & Approval Workflow Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_profiles_table", "label": "profiles Table Design", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_day_off_requests_table", "label": "day_off_requests Table Design", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_rls_policies", "label": "RLS Policy Design (resident vs chief scoping)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residents may only INSERT/SELECT their own resident_id rows and UPDATE status pending->cancelled; only a chief profile may SELECT all / decide any row \u2014 this is the app's first real per-user RLS, distinct from res_state's wide-open posture."}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_auth_magic_link", "label": "Magic-Link Auth with Domain Restriction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_email_notifications", "label": "Email Notifications (Resend via Edge Function)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_known_limitation", "label": "Known Limitation: 'Residents Never See Schedule' is UI-only", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consciously accepted, not a bug: /requests reads the same wide-open-RLS res_state row as the chief's cloud sync, so the entire schedule crosses the wire before the UI narrows it; the unauthenticated '/' route can also be visited directly. Closing this for real would need a narrow RLS-scoped view/Edge Function plus real auth on '/' \u2014 out of scope for this feature."}], "edges": [{"source": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_workflow", "target": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_profiles_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_workflow", "target": "docs_superpowers_specs_2026_07_18_resident_day_off_requests_design_day_off_requests_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-18-resident-day-off-requests-design.md", "source_location": n