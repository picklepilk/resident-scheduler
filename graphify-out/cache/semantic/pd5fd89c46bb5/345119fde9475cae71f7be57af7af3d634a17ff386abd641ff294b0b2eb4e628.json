{"nodes": [{"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_plan", "label": "User Feedback + Admin Portal Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task1_schema_helper", "label": "Task 1: feedback Schema, submitFeedback, app_version", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prefer: 'return=minimal' is required on insert because Postgres RLS only returns an INSERT...RETURNING row if a SELECT policy also grants read access, and anon deliberately has none on this table."}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task2_widget", "label": "Task 2: Floating Feedback Widget (Button + Modal)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task3_crash_capture", "label": "Task 3: Crash Auto-Capture in main.jsx", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task4_admin_function", "label": "Task 4: feedback-admin Netlify Function + netlify.toml", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The /api/feedback-admin/* redirect must be placed before the SPA catch-all /* redirect in netlify.toml, since Netlify redirects are matched top-to-bottom; reversed order would serve index.html for every function call."}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task5_admin_tab", "label": "Task 5: Feedback Admin Tab (Password-Gated Triage UI)", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 'feedback' entry stays a fixed member of the static TABS array (so reconcileTabOrder/backup-restore keep working unchanged) and is instead filtered out of SidebarNav's rendering when cloud sync is off, rather than being conditionally omitted from TABS itself."}, {"id": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task6_env_docs", "label": "Task 6: Document Server-Only Feedback Env Vars", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_07_18_user_feedback_plan_plan", "target": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task1_schema_helper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_18_user_feedback_plan_plan", "target": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task2_widget", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-07-18-user-feedback-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_07_18_user_feedback_plan_plan", "target": "docs_superpowers_plans_2026_07_18_user_feedback_plan_task3_crash