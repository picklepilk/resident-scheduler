# Copy to solver-service/.env.remote (gitignored via .env.*) on EACH Windows PC. NEVER commit the
# real file. Read by run-remote.ps1. Format: KEY=value, one per line, '#' comments.
SOLVER_AUTH_MODE=supabase
# Project URL (public). Verifies session tokens via ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#SUPABASE_JWT_SECRET=
# The owner's own two account emails, comma-separated. Required: run-remote.ps1 refuses to start
# without it (otherwise any signed-up account would pass). Typed here only, never in the repo.
SOLVER_ALLOWED_EMAILS=you@example.com,you-alt@example.com
# Live app origin (+ localhost dev if wanted). Comma-separated.
SOLVER_CORS_ORIGINS=https://residentscheduling.netlify.app,http://localhost:5173
# /health reports host=pc, preferJobs=true, defaultBudgetSeconds -> app submits via /jobs + poll.
SOLVER_HOST_KIND=pc
#SOLVER_DEFAULT_BUDGET_SECONDS=300
# Per-user bucket and pre-auth per-IP (every tailnet request arrives via tailscale serve from
# 127.0.0.1, so the pre-auth limit is effectively global: keep it generous for polling).
SOLVER_RATE_PER_MIN=6
SOLVER_RATE_BURST=3
SOLVER_PREAUTH_RATE_PER_MIN=120
SOLVER_PREAUTH_RATE_BURST=30
# 0 or unset = every core on this PC.
#SOLVER_NUM_WORKERS=0
