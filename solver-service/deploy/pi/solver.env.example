# Copy to ~/.config/resident-solver/solver.env (chmod 600). NEVER commit the real file.
SOLVER_AUTH_MODE=supabase
# Project URL (public). Verifies tokens against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json and
# pins iss. Legacy HS256 projects can instead set SUPABASE_JWT_SECRET (a real secret).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#SUPABASE_JWT_SECRET=
# Comma-separated emails allowed to run the solver (admins only). Required by the unit.
SOLVER_ALLOWED_EMAILS=admin1@example.org,admin2@example.org
# Only the live app origin(s) (and nothing else) -- no localhost in production.
SOLVER_CORS_ORIGINS=https://residentscheduling.netlify.app
# Per-user bucket: 6/min burst 3. Preauth is per client IP; Funnel connections all arrive from
# 127.0.0.1, so it is effectively a global cap -- keep it generous enough for polling.
SOLVER_RATE_PER_MIN=6
SOLVER_RATE_BURST=3
SOLVER_PREAUTH_RATE_PER_MIN=120
SOLVER_PREAUTH_RATE_BURST=30
SOLVER_MAX_BODY_BYTES=5242880
SOLVER_NUM_WORKERS=4
# Makes /health report host=pi, preferJobs=true, defaultBudgetSeconds: the app then labels the
# backend "Cloud (Pi)", uses submit-then-poll /jobs, and defaults Generate to that budget (300 s;
# 300 s portfolio 1 beat 120 s on the real-data benchmark). Remove SOLVER_HOST_KIND to behave like Fly.
SOLVER_HOST_KIND=pi
#SOLVER_DEFAULT_BUDGET_SECONDS=300
