# Copied to ~/resident-solver/solver.env by install.sh (chmod 600). NEVER commit the real file.
SOLVER_AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Comma-separated admin emails allowed to run the solver.
SOLVER_ALLOWED_EMAILS=admin1@example.org,admin2@example.org
SOLVER_CORS_ORIGINS=https://residentscheduling.netlify.app
SOLVER_RATE_PER_MIN=6
SOLVER_RATE_BURST=3
SOLVER_PREAUTH_RATE_PER_MIN=120
SOLVER_PREAUTH_RATE_BURST=30
SOLVER_MAX_BODY_BYTES=5242880
# Leave CP-SAT default workers, or set to the Mac's performance core count.
#SOLVER_NUM_WORKERS=8
# pc = "Cloud (PC)" label, submit-then-poll /jobs, advertised default budget.
SOLVER_HOST_KIND=pc
#SOLVER_DEFAULT_BUDGET_SECONDS=300
# install.sh rewrites this line to $HOME/resident-solver/runlog on first run.
SOLVER_RUNLOG_DIR=/tmp/resident-solver-runlog
